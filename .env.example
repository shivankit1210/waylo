# ==============================================
# Waylo — Environment Variables Template
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================

# Node environment
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/waylo?schema=public

# JWT Authentication
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Server
SERVER_PORT=3001
SERVER_URL=http://localhost:3001

# Frontend
VITE_API_URL=http://localhost:3001/api/v1

# AI Provider (optional — mock mode used when not configured)
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=openai

# Maps (optional — OpenStreetMap fallback used when not configured)
# MAPBOX_ACCESS_TOKEN=pk...

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
